{
  "name": "demoq-psa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p . && pnpm --filter @demoq/web typecheck",
    "lint": "eslint . && depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "db:setup": "bash scripts/db-setup.sh",
    "db:types": "node --env-file-if-exists=.env --import tsx packages/db/src/codegen.ts",
    "seed": "node --env-file-if-exists=.env --import tsx packages/testkit/src/seed.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "pnpm --filter @demoq/web dev",
    "build:web": "pnpm --filter @demoq/web build",
    "matrix:check": "node --env-file-if-exists=.env --import tsx scripts/matrix-check.ts",
    "trace:check": "node --env-file-if-exists=.env --import tsx scripts/spec-coverage.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm matrix:check && pnpm trace:check && pnpm test",
    "start:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9.39.5",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@demoq/core": "workspace:*",
    "@demoq/db": "workspace:*",
    "@demoq/shared": "workspace:*",
    "@demoq/testkit": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@node-rs/argon2": "^2.2.1",
    "fast-check": "^4.10.2",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
