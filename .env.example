# App role: INSERT/SELECT/UPDATE on business tables; INSERT/SELECT only on audit.
DATABASE_URL=postgres://demoq_app:demoq_app@localhost:5432/demoq_dev
# Migrator role owns the schema. Used only by `pnpm db:migrate`.
MIGRATOR_DATABASE_URL=postgres://demoq_migrator:demoq_migrator@localhost:5432/demoq_dev
# Test DBs are cloned from a migrated template (psa_template).
TEST_ADMIN_URL=postgres://demoq_migrator:demoq_migrator@localhost:5432/postgres
PORT=3000
TOTP_ENC_KEY=REPLACE_WITH_openssl_rand_-base64_32
TZ_BUSINESS=Asia/Phnom_Penh
# Serve the built PWA from the API (prod/staging/E2E). Leave unset in dev (Vite serves it).
# WEB_DIST=apps/web/dist
# Reverse-proxy hops in front of the API whose X-Forwarded-For we trust (prod: Cloudflare + DO LB = 2). Dev: 0.
TRUST_PROXY_HOPS=0
# Monthly bypass review (PRJ-BP-05): user id of the CEO or ops lead it is requested by. Unset = no review job.
# BYPASS_REVIEW_REQUESTER_ID=
# Telegram bot (optional in dev). Token from @BotFather; secret = the value set with setWebhook(secret_token=...).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# --- MCP OAuth (specs/channels/mcp-oauth.md). Defaults suit local dev; production requires the three marked (vault).
# Public origin of the API (the OAuth issuer; the MCP resource is $PUBLIC_BASE_URL/mcp). Prod: https://app.demoq.com.kh
# PUBLIC_BASE_URL=http://localhost:3000
# Prod (required): comma-separated secrets, >= 32 chars each, that sign the sign-in/consent cookies. Dev: random per start.
# OAUTH_COOKIE_KEYS=
# Prod (required): JWKS JSON with private signing keys. Dev: an RSA key is generated per start.
# OAUTH_JWKS=
# D-MC-1: the pre-registered Cowork / claude.ai custom-connector client.
# MCP_COWORK_CLIENT_ID=demoq-cowork
# MCP_COWORK_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback
# Dev/test only: accept http://127.0.0.1 client metadata documents. Refused when NODE_ENV=production.
# OAUTH_DEV_ALLOW_HTTP_CIMD=false
# OAUTH_RATE_PER_MIN=120
# D-MC-3: writes over MCP are OFF until an admin runs the mcp.set_writes operation (dev: turn it on to try write tools).
